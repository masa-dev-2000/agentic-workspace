{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mira/contracts/improvement-proposal.schema.json",
  "title": "ImprovementProposal",
  "description": "Inactive, testable proposal routed to the smallest effective intervention.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "proposalId",
    "signalRefs",
    "target",
    "summary",
    "hypothesis",
    "candidateRef",
    "risk",
    "testRefs",
    "status",
    "proposalHash",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "proposalId": { "$ref": "#/$defs/id" },
    "signalRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": [
            "dictionary",
            "agents-policy",
            "existing-skill",
            "skill-edge",
            "hook",
            "runtime",
            "new-skill"
          ]
        },
        "ref": { "$ref": "#/$defs/reference" }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "hypothesis": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "candidateRef": { "$ref": "#/$defs/reference" },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "blastRadius", "reversible"],
      "properties": {
        "level": { "enum": ["low", "medium", "high", "critical"] },
        "blastRadius": { "enum": ["single-use", "single-skill", "workflow", "global"] },
        "reversible": { "type": "boolean" },
        "rollbackRef": { "$ref": "#/$defs/reference" }
      }
    },
    "testRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    },
    "status": {
      "enum": [
        "draft",
        "testing",
        "awaiting-approval",
        "approved",
        "rejected",
        "active-experiment",
        "rolled-back",
        "promoted"
      ]
    },
    "proposalHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "createdAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://"
    },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
