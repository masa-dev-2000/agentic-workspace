{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NameWorkSessionResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionName",
    "status"
  ],
  "properties": {
    "sessionName": {
      "type": "string",
      "description": "ASCII kebab-case semantic name without date or status.",
      "minLength": 5,
      "maxLength": 48,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+){2,7}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "waiting",
        "blocked",
        "done",
        "archived"
      ]
    }
  }
}
